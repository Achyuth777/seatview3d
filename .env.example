# Copy to .env (never commit .env) and fill in. Used by docker-compose.yml.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Host port for the app (http://localhost:3001)
APP_PORT=3001
HOLD_MINUTES=10
# Comma-separated exact origins allowed cross-origin; empty = same-origin only
ALLOWED_ORIGINS=
# true only behind your own reverse proxy (nginx, Caddy, a load balancer) that sets X-Forwarded-For
TRUST_PROXY=false
LOG_LEVEL=info
# Live showtimes (optional). Keep these server-side. MovieGlu's evaluation licence forbids publishing data,
# so set MOVIEGLU_LICENSED=true only with a licence that allows it.
MOVIEGLU_CLIENT=
MOVIEGLU_API_KEY=
MOVIEGLU_AUTHORIZATION=
MOVIEGLU_LICENSED=false
FEED_REFRESH_MINUTES=60
# Public origin of the site, used in emailed links. Required in production (https).
APP_ORIGIN=https://seatview.example
# Session lifetime in hours (default 30 days).
SESSION_HOURS=720
# Email: only "outbox" exists (simulated: messages are recorded, nothing is sent) until a provider is connected.
MAILER=outbox
# Admins must pass TOTP two-step sign-in. Always on in production.
ADMIN_MFA_REQUIRED=true
# Showtime provider: none | movieglu (licensed only). "fixture" is a simulated test feed, refused in production.
FEED_PROVIDER=none
FEED_CACHE_HOURS=6
