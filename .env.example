# Copy to .env (never commit .env) and fill in. Used by docker-compose.yml.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Host port for the app (http://localhost:3001)
APP_PORT=3001
HOLD_MINUTES=10
# Comma-separated exact origins allowed cross-origin; empty = same-origin only
ALLOWED_ORIGINS=
# true only behind your own reverse proxy (nginx, Caddy, a load balancer) that sets X-Forwarded-For
TRUST_PROXY=false
LOG_LEVEL=info
# Live showtimes (optional). Keep these server-side. MovieGlu's evaluation licence forbids publishing data,
# so set MOVIEGLU_LICENSED=true only with a licence that allows it.
MOVIEGLU_CLIENT=
MOVIEGLU_API_KEY=
MOVIEGLU_AUTHORIZATION=
MOVIEGLU_LICENSED=false
FEED_REFRESH_MINUTES=60
